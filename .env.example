# ============================================================
# ARIMS Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ============================================================

# ── Database (MySQL) ──────────────────────────────────────────
# Leave blank to run ARIMS without a database (in-memory mode).
# DATABASE_URL=mysql+pymysql://arims_user:changeme@localhost:3306/arims_db
DATABASE_URL=

# ── Model ─────────────────────────────────────────────────────
MODEL_TYPE=yolov8
MODEL_PATH=
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
DEVICE=cpu

# ── API Server ────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Scheduling ────────────────────────────────────────────────
MONTHLY_BUDGET=8300000
DAILY_CAPACITY=3
AVAILABLE_CREWS=5

# ── Priority Weights (must sum to 1.0) ────────────────────────
WEIGHT_SEVERITY=0.30
WEIGHT_SAFETY=0.25
WEIGHT_TRAFFIC=0.20
WEIGHT_DEGRADATION=0.15
WEIGHT_COST_EFFICIENCY=0.10

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
DEBUG=false
